# 默认拉取最新正式镜像；回滚时替换为已验证的固定版本 tag。
CLOUD_IMAGE_NAME=ghcr.io/javdbviewed/javdbviewed-cloud:latest

# 必填：至少 16 位强随机值，例如 openssl rand -hex 32。
CLOUD_JWT_SECRET=

# 可选：首次管理员密码。留空时仅在首次启动日志输出一次临时密码。
CLOUD_ADMIN_PASSWORD=

# 可选：限制浏览器访问 Origin，多个值用英文逗号分隔。
CLOUD_CORS_ORIGINS=

# 可选：更新清单镜像地址，多个值用英文逗号分隔。
CLOUD_UPDATE_MANIFEST_MIRRORS=
